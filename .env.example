# Crea la chiave in Gestpay Dashboard → Configuration → Security → APIKEY.
FABRICK_SHOP_LOGIN=GESPAY12345
FABRICK_API_KEY=replace-me

# L'app ascolta solo sulla macchina locale.
PORT=3000

# Redirect per il browser del cliente. Localhost va bene sullo stesso computer.
# Usa un URL pubblico solo se il browser gira su un altro dispositivo.
APP_ORIGIN=http://localhost:3000

# Notifiche server-to-server: Fabrick deve raggiungere questo URL HTTPS.
# Avvia un tunnel verso la porta 3000 e inserisci qui l'origine senza /notification.
# FABRICK_S2S_ORIGIN=https://your-tunnel.example
